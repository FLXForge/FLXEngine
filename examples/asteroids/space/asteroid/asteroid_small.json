      },
      "tone": {
        "material": {
          "brightness": 0.45,
          "roughness": 0.7,
          "noise": 0.35,
          "resonance": 0.0,
          "metal": 0.0
        }
      },
      "duration": 0.08,
      "volume": 0.3
    }
  },
  "group": "asteroid",
  "behavior": {
    "scripts": [
      "asteroid_small"
    ]
  },
  "children": {
    "fragment": {
      "like": "asteroid_fragment",
      "spawn": "manual"
    }
  }
}

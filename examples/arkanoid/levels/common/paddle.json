{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "origin": {
    "x": 300,
    "y": 280
  },
  "states": {
    "initial": "playing",
    "playing": {
      "next": [
        "respawn"
      ]
    },
    "respawn": {
      "next": [
        "playing"
      ]
    }
  },
  "spawn": "manual",
  "shape": {
    "type": "block",
    "mode": "fill",
    "color": "grey",
    "size": {
      "width": 70,
      "height": 10
    }
  },
  "mechanics": {
    "type": "direct",
    "motion": {
      "speed": {
        "start": 200
      }
    }
  },
  "control": {
    "player": 1
  },
  "group": "paddle",
  "children": {
    "ball": "ball"
  },
  "behavior": {
    "scripts": [
      "paddle"
    ]
  },
  "sounds": {
    "pop": {
      "kind": {
        "source": {
          "type": "oscillator",
          "wave": "square"
        },
        "note": 900,
        "slide": 300,
        "movement": {
          "type": "rise",
          "amount": 0.35
        }
      },
      "duration": 0.06,
      "volume": 0.35
    }
  },
  "collisions": {
    "body": {
      "type": "box",
      "size": {
        "width": 70,
        "height": 10
      },
      "offset": {
        "x": 35,
        "y": 5
      },
      "with": [
        "wall_side",
        "powerup"
      ]
    }
  }
}

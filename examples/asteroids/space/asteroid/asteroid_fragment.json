{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "shape": {
    "type": "line",
    "color": "orange",
    "size": {
      "width": 1,
      "height": 10
    }
  },
  "collision": {
    "type": "none"
  },
  "bounds": {
    "mode": "wrap",
    "overflow": false
  },
  "mechanics": {
    "type": "polar",
    "rotation": {
      "speed": {
        "start": 180
      }
    }
  },
  "behavior": {
    "scripts": [
      "asteroid_fragment"
    ]
  }
}

{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "origin": {
    "x": 70,
    "y": 65
  },
  "spawn": "manual",
  "children": {
    "redbrick": {
      "like": "../common/brick.json",
      "visual": {
        "color": "red",
        "representation": [
          {
            "primitive": "rectangle"
          }
        ]
      }
    },
    "bluebrick": {
      "like": "../common/brick.json",
      "spawn": "manual",
      "visual": {
        "color": "blue",
        "representation": [
          {
            "primitive": "rectangle"
          }
        ]
      }
    }
  },
  "creation": {
    "mode": "grid",
    "rules": {
      "rows": 6,
      "columns": 13,
      "cellWidth": 40,
      "cellHeight": 15
    },
    "pattern": [
      "redbrick",
      "bluebrick"
    ]
  }
}

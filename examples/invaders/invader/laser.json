{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "mechanics": {
    "type": "polar",
    "motion": {
      "speed": {
        "start": 160
      }
    },
    "rotation": {
      "angle": 180
    }
  },
  "group": "enemy",
  "behavior": {
    "scripts": [
      "laser"
    ]
  },
  "collisions": {
    "body": {
      "type": "box"
    }
  },
  "size": {
    "width": 2,
    "height": 8
  },
  "visual": {
    "color": "red",
    "representation": [
      {
        "primitive": "rectangle",
        "mode": "fill"
      }
    ]
  }
}

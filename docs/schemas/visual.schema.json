{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual.schema.json",
  "title": "FLX Visual",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "palette": {
      "oneOf": [
        {
          "$ref": "#/$defs/paletteMap"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/paletteMap"
              }
            ]
          }
        }
      ],
      "description": "Ordered palette composition, last key wins. References use the existing FLX source reference syntax. Aliases are local and case sensitive."
    },

    "color": {
      "type": "string",
      "description": "Palette key, native FLX color or #RGB/#RRGGBB. Unknown colors fail compilation. Never tints bitmap pixels."
    },

    "depth": {
      "type": "integer",
      "default": 0,
      "description": "Visual draw depth. Lower values are drawn first."
    },

    "representation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representationElement"
      }
    }
  },

  "$defs": {
    "axisSize": {
      "oneOf": [
        { "type": "number" },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?%$" }
      ]
    },

    "representationSize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "$ref": "#/$defs/axisSize" },
        "height": { "$ref": "#/$defs/axisSize" }
      }
    },

    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "x", "y" ],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },

    "common": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        }
      }
    },

    "primitiveElement": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [ "primitive" ],
          "additionalProperties": false,
          "properties": {
            "primitive": {
              "type": "string",
              "enum": [ "rectangle", "triangle", "ellipse" ]
            },
            "mode": {
              "type": "string",
              "enum": [ "fill", "outline" ],
              "default": "fill"
            },
            "size": {
              "$ref": "#/$defs/representationSize"
            },
            "persist": { "enum": [ "first", "last" ], "description": "Base-only stable first/replaceable/last grouping, including without playback; forbidden in animation key representations." },
            "color": {
              "type": "string"
            }
          }
        }
      ]
    },

    "geometryElement": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [ "geometry" ],
          "additionalProperties": false,
          "properties": {
            "geometry": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              },
              "minItems": 1
            },
            "mode": {
              "type": "string",
              "enum": [ "open", "close", "fill" ],
              "default": "open"
            },
            "persist": { "enum": [ "first", "last" ], "description": "Base-only stable first/replaceable/last grouping, including without playback; forbidden in animation key representations." },
            "color": {
              "type": "string"
            }
          }
        }
      ]
    },

    "textElement": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [ "text", "fontSize" ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "fontSize": {
              "type": "integer",
              "minimum": 1
            },
            "persist": { "enum": [ "first", "last" ], "description": "Base-only stable first/replaceable/last grouping, including without playback; forbidden in animation key representations." },
            "color": {
              "type": "string"
            }
          }
        }
      ]
    },

    "nativeColor": {
      "type": "string",
      "pattern": "^(#[0-9A-Fa-f]{3}|#[0-9A-Fa-f]{6}|[lL][iI][gG][hH][tT][gG][rR][aA][yY]|[lL][iI][gG][hH][tT][gG][rR][eE][yY]|[gG][rR][aA][yY]|[gG][rR][eE][yY]|[dD][aA][rR][kK][gG][rR][aA][yY]|[dD][aA][rR][kK][gG][rR][eE][yY]|[yY][eE][lL][lL][oO][wW]|[gG][oO][lL][dD]|[oO][rR][aA][nN][gG][eE]|[pP][iI][nN][kK]|[rR][eE][dD]|[mM][aA][rR][oO][oO][nN]|[gG][rR][eE][eE][nN]|[lL][iI][mM][eE]|[dD][aA][rR][kK][gG][rR][eE][eE][nN]|[sS][kK][yY][bB][lL][uU][eE]|[bB][lL][uU][eE]|[dD][aA][rR][kK][bB][lL][uU][eE]|[pP][uU][rR][pP][lL][eE]|[vV][iI][oO][lL][eE][tT]|[dD][aA][rR][kK][pP][uU][rR][pP][lL][eE]|[bB][eE][iI][gG][eE]|[bB][rR][oO][wW][nN]|[dD][aA][rR][kK][bB][rR][oO][wW][nN]|[wW][hH][iI][tT][eE]|[bB][lL][aA][cC][kK]|[bB][lL][aA][nN][kK]|[mM][aA][gG][eE][nN][tT][aA]|[rR][aA][yY][wW][hH][iI][tT][eE])$",
      "description": "Native FLX color, case insensitive, or #RGB/#RRGGBB. Palette values never resolve aliases."
    },

    "paletteMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nativeColor"
      }
    },

    "bitmapPattern": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 255,
          "items": {
            "type": "string"
          }
        }
      ]
    },

    "horizontalPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "$ref": "#/$defs/bitmapPattern"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "default": 1
        }
      }
    },

    "bitmapRow": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 255,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/horizontalPattern"
              }
            ]
          }
        }
      ]
    },

    "repeatedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row"
      ],
      "properties": {
        "row": {
          "$ref": "#/$defs/bitmapRow"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "default": 1
        }
      }
    },

    "bitmapElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bitmap"
      ],
      "properties": {
        "bitmap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pixels"
          ],
          "properties": {
            "pixels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 255,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/bitmapRow"
                  },
                  {
                    "$ref": "#/$defs/repeatedRow"
                  }
                ]
              },
              "description": "Expanded dimensions must be rectangular and 1..255; the compiler checks expanded dimensions and all color tokens."
            }
          }
        },
        "persist": { "enum": [ "first", "last" ], "description": "Base-only stable first/replaceable/last grouping, including without playback; forbidden in animation key representations." },
        "size": {
          "$ref": "#/$defs/representationSize"
        },
        "color": {
          "type": "string",
          "description": "Validated but does not tint bitmap pixels."
        }
      }
    },

    "representationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "like"
      ],
      "properties": {
        "bitmap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pixels"
          ],
          "properties": {
            "pixels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 255,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/bitmapRow"
                  },
                  {
                    "$ref": "#/$defs/repeatedRow"
                  }
                ]
              },
              "description": "Expanded dimensions must be rectangular and 1..255; the compiler checks expanded dimensions and all color tokens."
            }
          }
        },
        "color": {
          "type": "string",
          "description": "Validated but does not tint bitmap pixels."
        },
        "fontSize": {
          "type": "integer",
          "minimum": 1
        },
        "geometry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 1
        },
        "like": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "open",
            "close",
            "fill"
          ],
          "default": "open"
        },
        "persist": {
          "enum": [
            "first",
            "last"
          ],
          "description": "Base-only stable first/replaceable/last grouping, including without playback; forbidden in animation key representations."
        },
        "primitive": {
          "type": "string",
          "enum": [
            "rectangle",
            "triangle",
            "ellipse"
          ]
        },
        "size": {
          "$ref": "#/$defs/representationSize"
        },
        "text": {
          "type": "string"
        }
      },
      "description": "Existing representation like reference and overrides. The compiler validates the resolved family, fields and inherited persist."
    },

    "representationElement": {
      "oneOf": [
        { "$ref": "#/$defs/primitiveElement" },
        { "$ref": "#/$defs/geometryElement" },
        { "$ref": "#/$defs/textElement" },
        { "$ref": "#/$defs/bitmapElement" },
        { "$ref": "#/$defs/representationReference" }
      ]
    }
  }
}

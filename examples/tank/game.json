{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",

  "origin": {
    "x": 320,
    "y": 160
  },

  "size": {
    "width": 640,
    "height": 320
  },

  "delimit": true,

  "visual": {
    "color": "#D8B878",
    "representation": [
      {
        "primitive": "rectangle",
        "mode": "fill"
      }
    ]
  },

  "children": {
    "player_spawn": {
      "origin": {
        "x": 90,
        "y": 160
      },
      "creation": {
        "mode": "iterator",
        "rules": {
          "concurrent": 1,
          "repeat": true
        },
        "pattern": [
          "tank"
        ]
      },
      "children": {
        "tank": {
          "like": "tank/player"
        }
      }
    },
    "enemy_spawn": {
      "origin": {
        "x": 550,
        "y": 160
      },
      "creation": {
        "mode": "iterator",
        "rules": {
          "concurrent": 1,
          "repeat": true
        },
        "pattern": [
          "tank"
        ]
      },
      "children": {
        "tank": {
          "like": "tank/enemy"
        }
      }
    },

    "top_wall": {
      "like": "arena/wall",
      "origin": {
        "x": 320,
        "y": 5
      },
      "size": {
        "width": 640,
        "height": 10
      }
    },

    "bottom_wall": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "states.schema.json",
  "title": "FLX Object States",
  "type": "object",
  "required": ["initial"],
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "next": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "initial": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "shape": {
    "type": "line",
    "color": "white",
    "size": {
      "width": 1,
      "height": 20
    }
  },
  "mechanics": {
    "type": "direct",
    "motion": {
      "inertia": 0.82
    },
    "rotation": {
      "speed": {
        "start": 30
      }
    }
  },
  "inherit": {
    "creation": {
      "velocity": "copy"
    }
  },
  "bounds": {
    "mode": "wrap",
    "overflow": false
  },
  "behavior": {
    "scripts": [
      "fragment"
    ]
  }
}

{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",

  "origin": {
    "x": 320,
    "y": 240
  },

  "shape": {
    "type": "circle",
    "mode": "fill",
    "color": "white",
    "size": {
      "width": 10,
      "height": 10
    }
  },

  "motion": {
    "speed": 200,
    "angle": 25
  },

  "group": "ball",

  "collision": {
    "type": "circle",
    "radius": 5,
    "active": true,
    "with": [
      "wall_side",
      "wall_top",
      "title",
      "paddle"
    ]
  },

  "behavior": {
    "scripts": [ "ball" ]
  },

  "sounds": {
    "paddle": {
      "kind": {
        "source": {
          "type": "oscillator",
          "wave": "square"
        },
        "note": 440
      },
      "duration": 0.08,
      "volume": 0.8
    }
  }

}

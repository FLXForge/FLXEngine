{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "origin": {
    "x": 320,
    "y": 160
  },
  "shape": {
    "type": "triangle",
    "mode": "outline",
    "color": "white",
    "size": {
      "width": 18,
      "height": 24
    }
  },
  "motion": {
    "rotationSpeed": 180,
    "acceleration": 120,
    "inertia": 0.99,
    "maxSpeed": 180
  },
  "bounds": {
    "mode": "wrap",
    "overflow": true
  },
  "group": "ship",
  "collision": {
    "type": "circle",
    "radius": 10
  },
  "behavior": {
    "scripts": [
      "../../scripts/ship"
    ]
  },
  "sounds": {
    "laser": {
      "wave": "square",
      "frequency": 880,
      "duration": 0.08,
      "volume": 0.7
    }
  },
  "children": {
    "laser": {
      "like": "laser",
      "spawn": "manual",
      "offset": {
        "x": 0,
        "y": -14
      }
    },
    "fragment": {
      "like": "ship_fragment",
      "spawn": "manual"
    },
    "tail": {
      "like": "tail",
      "spawn": "manual",
      "offset": {
        "y": 14
      }
    }
  }
}

{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "shape": {
    "type": "line",
    "color": "red",
    "size": {
      "width": 1,
      "height": 12
    }
  },
  "mechanics": {
    "type": "polar",
    "motion": {
      "speed": {
        "start": 300
      }
    }
  },
  "inherit": {
    "creation": {
      "angle": "copy",
      "velocity": "compose"
    }
  },
  "bounds": {
    "mode": "wrap",
    "overflow": false
  },
  "group": "laser",
  "collision": {
    "type": "circle",
    "radius": 2
  },
  "behavior": {
    "scripts": [
      "laser"
    ]
  }
}

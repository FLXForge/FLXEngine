{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collision.schema.json",
  "title": "FLX Collision",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "none",
        "box",
        "circle"
      ]
    },

    "active": {
      "type": "boolean"
    },

    "with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "radius": {
      "type": "number"
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collision.schema.json",
  "title": "FLX Collider",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "box",
        "ellipse"
      ]
    },

    "enabled": {
      "type": "boolean"
    },

    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },

    "offset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "default": 0 },
        "y": { "type": "number", "default": 0 }
      }
    },

    "angle": {
      "type": "number"
    },

    "with": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },

    "states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}

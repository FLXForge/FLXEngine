{
  "$schema": "../../../tools/schemas/drawable.schema.json",
  "name": "Laser",

  "shape": {
    "type": "line",
    "color": "RED",
    "size": {
      "width": 1,
      "height": 12
    }
  },

  "motion": {
    "inherit": "creation",
    "maxSpeed": 300
  },

  "bounds": {
    "mode": "wrap",
    "overflow": false
  },

  "group": "laser",

  "collision": {
    "type": "circle",
    "radius": 2
  },

  "behavior": {
    "scripts": [ "scripts/laser" ]
  }
}
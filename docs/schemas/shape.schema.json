{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shape.schema.json",
  "title": "FLX Shape",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "block",
        "rectangle",
        "triangle",
        "polygon",
        "circle",
        "line",
        "text"
      ],
      "default": "block"
    },

    "mode": {
      "type": "string",
      "enum": [
        "fill",
        "outline"
      ]
    },

    "color": {
      "type": "string",
      "description": "Named raylib color or hexadecimal value in #rgb or #rrggbb format."
    },

    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": [ "x", "y" ],
        "additionalProperties": false
      }
    },

    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "width", "height" ],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },

    "radius": {
      "type": "number"
    },

    "content": {
      "type": "string",
      "description": "Visible text for shapes with type text."
    }
  }
}

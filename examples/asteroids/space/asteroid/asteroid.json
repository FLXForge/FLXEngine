{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "sounds": {
    "pfooom": {
      "kind": {
        "source": {
          "type": "noise",
          "wave": "noise"
        },
        "note": 300,
        "slide": -200,
        "movement": {
          "type": "fall",
          "amount": 0.25
        }
      },
      "tone": {
        "material": {
          "brightness": 0.35,
          "roughness": 0.8,
          "noise": 0.4,
          "resonance": 0.1,
          "metal": 0.0
        }
      },
      "duration": 0.18,
      "volume": 0.5
    }
  },
  "bounds": {
    "mode": "wrap",
    "overflow": true
  },
  "mechanics": {
    "type": "direct",
    "rotation": {
      "speed": {
        "start": 90
      }
    }
  },
  "group": "asteroid",
  "behavior": {
    "scripts": [
      "asteroid"
    ]
  },
  "children": {
    "small": {
      "like": "asteroid_small",
      "spawn": "manual"
    },
    "fragment": {
      "like": "asteroid_fragment",
      "spawn": "manual"
    }
  },
  "collisions": {
    "body": {
      "type": "ellipse",
      "size": {
        "width": 32.0,
        "height": 32.0
      },
      "with": [
        "ship",
        "asteroid",
        "laser"
      ]
    }
  }
}

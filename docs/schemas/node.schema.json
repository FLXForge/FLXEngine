{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLX Node",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "$schema": {
      "type": "string"
    },

    "name": {
      "type": "string"
    },

    "like": {
      "type": "string"
    },

    "description": {
      "type": "string"
    },

    "group": {
      "type": "string"
    },

    "collision": {
      "$ref": "collision.schema.json"
    },

    "visible": {
      "type": "boolean"
    },

    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "x", "y" ],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },

    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "width", "height" ],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },

    "color": {
      "type": "string"
    },

    "shape": {
      "$ref": "shape.schema.json"
    },

    "motion": {
      "$ref": "motion.schema.json"
    },

    "bounds": {
      "$ref": "bounds.schema.json"
    },

    "speed": {
      "type": "number"
    },

    "angle": {
      "type": "number"
    },

    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {

        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }

      }
    },

    "children": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "node.schema.json" }
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "node.schema.json" }
            ]
          }
        }
      ]
    },

    "spawns": {
      "$ref": "spawns.schema.json"
    }
  },

  "required": [
    "name"
  ]
}

{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "behavior": {
    "scripts": [
      "references-demo"
    ]
  },
  "children": {
    "target": {
      "origin": {
        "x": 50,
        "y": 80
      },
      "shape": {
        "type": "block",
        "color": "yellow",
        "size": {
          "width": 12,
          "height": 12
        }
      },
      "mechanics": {
        "type": "direct",
        "motion": {
          "speed": {
            "start": 70
          }
        }
      },
      "behavior": {
        "scripts": [
          "target"
        ]
      }
    },
    "marker": {
      "origin": {
        "x": 50,
        "y": 120
      },
      "shape": {
        "type": "block",
        "mode": "outline",
        "color": "cyan",
        "size": {
          "width": 16,
          "height": 16
        }
      }
    }
  }
}

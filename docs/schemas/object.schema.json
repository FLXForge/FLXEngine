{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object.schema.json",
  "title": "FLX Object",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "$schema": {
      "type": "string"
    },

    "like": {
      "type": "string"
    },

    "spawn": {
      "type": "string",
      "enum": [ "auto", "manual" ],
      "default": "auto"
    },

    "component": {
      "type": "boolean",
      "default": false
    },

    "creation": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "creation.schema.json" }
      ]
    },

    "offset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "default": 0 },
        "y": { "type": "number", "default": 0 }
      }
    },

    "visible": {
      "type": "boolean"
    },

    "attach": {
      "$ref": "attach.schema.json"
    },

    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },

    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "width", "height" ],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },

    "visual": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "visual.schema.json" }
      ]
    },

    "mechanics": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "mechanics.schema.json" }
      ]
    },

    "inherit": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "inherit.schema.json" }
      ]
    },

    "bounds": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "bounds.schema.json" }
      ]
    },

    "delimit": {
      "type": "boolean"
    },

    "group": {
      "type": "string"
    },

    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "player": {
          "type": "integer",
          "minimum": 1
        }
      }
    },

    "local": {
      "type": "object",
      "additionalProperties": {
        "type": [ "string", "number", "boolean" ]
      }
    },

    "collisions": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "collision.schema.json" }
            ]
          }
        }
      ]
    },

    "behavior": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "behavior.schema.json" }
      ]
    },

    "states": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "states.schema.json" }
      ]
    },

    "sounds": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "sound.schema.json" }
        ]
      }
    },

    "music": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "music.schema.json" }
        ]
      }
    },

    "children": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "object.schema.json" }
        ]
      }
    }
  },

  "not": {
    "anyOf": [
      { "required": [ "color" ] },
      { "required": [ "layer" ] },
      { "required": [ "depth" ] },
      { "required": [ "shape" ] },
      { "required": [ "speed" ] },
      { "required": [ "angle" ] },
      { "required": [ "motion" ] },
      { "required": [ "role" ] },
      { "required": [ "collision" ] }
    ]
  }
}

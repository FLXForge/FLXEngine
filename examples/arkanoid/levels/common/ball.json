{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",

  "offset": {
    "x": 35,
    "y": -5
  },

  "shape": {
    "type": "circle",
    "mode": "fill",
    "color": "white",
    "size": {
      "width": 10,
      "height": 10
    }
  },

  "motion": {
    "speed": 200,
    "angle": 25
  },

  "attach": {
    "born": true,
    "x": true
  },

  "group": "ball",

  "collision": {
    "type": "circle",
    "radius": 5,
    "active": true,
    "with": [
      "wall_side",
      "wall_top",
      "title",
      "paddle"
    ]
  },

  "behavior": {
    "scripts": [ "ball" ]
  },

  "sounds": {
    "paddle": {
      "wave": "square",
      "frequency": 440,
      "duration": 0.08,
      "volume": 0.8
    }
  }

}
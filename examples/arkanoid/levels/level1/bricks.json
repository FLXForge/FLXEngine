{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",

  "origin": {
    "x": 100,
    "y": 100
  },

  "spawn": "manual",

  "children": {
    "redbrick": {
      "shape": {
        "type": "block",
        "mode": "fill",
        "color": "red",
        "size": {
          "width": 20,
          "height": 20
        }
      }
    }
  },

  "creation": {
    "mode": "grid",
    "rules": {
      "rows": 5,
      "columns": 10,
      "cellWidth": 30,
      "cellHeight": 30
    },
    "pattern": [
      "redbrick"
    ]
  }

}
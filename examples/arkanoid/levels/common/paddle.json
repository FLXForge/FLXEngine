{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",

  "origin": {
    "x": 300,
    "y": 280
  },

  "spawn": "manual",

  "shape": {
    "type": "block",
    "mode": "fill",
    "color": "grey",
    "size": {
      "width": 70,
      "height": 10
    }
  },

  "motion": {
    "speed": 200
  },

  "group": "paddle",

  "collision": {
    "type": "box",
    "size": {
      "width": 10,
      "height": 70
    }
  },

  "children": {
    "ball": "ball"
  },

  "behavior": {
    "scripts": [ "paddle" ]
  }

}
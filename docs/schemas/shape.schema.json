{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shape.schema.json",
  "title": "FLX Shape",
  "type": "object",
  "additionalProperties": false,

  "required": [ "type", "color", "size" ],

  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "block",
        "rectangle",
        "triangle",
        "polygon",
        "circle",
        "line"
      ],
      "default": "block"
    },

    "mode": {
      "type": "string",
      "enum": [
        "fill",
        "outline"
      ]
    },

    "color": {
      "type": "string",
      "enum": [
        "red",
        "green",
        "blue",
        "black",
        "yellow",
        "orange",
        "purple",
        "gray",
        "white",
        "brown"
      ]
    },

    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": [ "x", "y" ],
        "additionalProperties": false
      }
    },

    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "width", "height" ],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },

    "radius": {
      "type": "number"
    },

    "text": {
      "type": "string"
    },

    "fontSize": {
      "type": "number"
    }
  }
}
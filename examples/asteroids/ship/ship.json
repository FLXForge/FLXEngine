{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "mechanics": {
    "type": "polar",
    "motion": {
      "speed": {
        "limit": 180
      },
      "acceleration": 120,
      "inertia": 0.99
    },
    "rotation": {
      "speed": {
        "start": 180
      }
    }
  },
  "bounds": {
    "mode": "wrap",
    "overflow": true
  },
  "control": {
    "player": 1
  },
  "group": "ship",
  "behavior": {
    "scripts": [
      "ship"
    ]
  },
  "sounds": {
    "laser": "/ship/ship_sounds:laser",
    "dead": "/ship/ship_sounds:dead",
    "motor": "/ship/ship_sounds:motor"
  },
  "children": {
    "laser": {
      "like": "laser",
      "spawn": "manual",
      "offset": {
        "x": 0,
        "y": -14
      }
    },
    "fragment": {
      "like": "ship_fragment",
      "spawn": "manual"
    },
    "tail": {
      "like": "tail",
      "spawn": "manual",
      "offset": {
        "y": 14
      }
    }
  },
  "collisions": {
    "body": {
      "type": "ellipse",
      "size": {
        "width": 20,
        "height": 20
      },
      "with": [
        "asteroid"
      ]
    }
  },
  "size": {
    "width": 18,
    "height": 24
  },
  "visual": {
    "color": "white",
    "representation": [
      {
        "primitive": "triangle",
        "mode": "outline"
      }
    ]
  }
}

{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "origin": {
    "x": 320,
    "y": 160
  },
  "shape": {
    "type": "triangle",
    "mode": "outline",
    "color": "white",
    "size": {
      "width": 18,
      "height": 24
    }
  },
  "motion": {
    "rotationSpeed": 180,
    "acceleration": 120,
    "inertia": 0.99,
    "maxSpeed": 180
  },
  "bounds": {
    "mode": "wrap",
    "overflow": true
  },
  "control": {
    "player": 1
  },
  "group": "ship",
  "collision": {
    "type": "circle",
    "radius": 10
  },
  "behavior": {
    "scripts": [
      "ship"
    ]
  },
  "sounds": {
    "laser": {
      "kind": {
        "source": {
          "type": "oscillator",
          "wave": "square"
        },
        "note": "/music/notes:laser",
        "slide": -300,
        "movement": {
          "type": "fall",
          "amount": 0.25
        }
      },
      "tone": {
        "material": {
          "brightness": 0.9,
          "roughness": 0.1,
          "noise": 0.02,
          "resonance": 0.1,
          "metal": 0.0
        }
      },
      "duration": 0.05,
      "volume": 0.4
    },
    "dead": {
      "kind": {
        "source": {
          "type": "oscillator",
          "wave": "saw"
        },
        "note": 800,
        "slide": -700,
        "movement": {
          "type": "fall",
          "amount": 0.8
        }
      },
      "tone": {
        "material": {
          "brightness": 0.55,
          "roughness": 0.7,
          "noise": 0.1,
          "resonance": 0.15,
          "metal": 0.0
        }
      },
      "duration": 0.35,
      "volume": 0.4
    },
    "motor": {
      "kind": {
        "source": {
          "type": "oscillator",
          "wave": "triangle"
        },
        "note": 100
      },
      "tone": {
        "material": {
          "brightness": 0.25,
          "roughness": 0.2,
          "noise": 0.0,
          "resonance": 0.0,
          "metal": 0.0
        }
      },
      "duration": 0.05,
      "volume": 0.15
    }
  },
  "children": {
    "laser": {
      "like": "laser",
      "spawn": "manual",
      "offset": {
        "x": 0,
        "y": -14
      }
    },
    "fragment": {
      "like": "ship_fragment",
      "spawn": "manual"
    },
    "tail": {
      "like": "tail",
      "spawn": "manual",
      "offset": {
        "y": 14
      }
    }
  }
}

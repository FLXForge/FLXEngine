{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spawns.schema.json",
  "title": "FLX Spawns",
  "type": "object",

  "additionalProperties": {
    "type": "object",
    "required": [ "prefab" ],

    "properties": {
      "prefab": {
        "type": "string"
      },
      "offset": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "default": 0
          },
          "y": {
            "type": "number",
            "default": 0
          }
        },
        "required": [ "x", "y" ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}